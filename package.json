{
  "name": "evogent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "node --require ./scripts/brace-expansion-compat.cjs ./node_modules/eslint/bin/eslint.js",
    "test": "NODE_OPTIONS=\"--require=$PWD/scripts/brace-expansion-compat.cjs\" tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx' 'test/**/*.test.ts' 'test/**/*.test.mjs' 'scripts/**/*.test.ts'",
    "test:pages": "NODE_OPTIONS=\"--require=$PWD/scripts/brace-expansion-compat.cjs\" tsx --test 'src/app/**/*.test.tsx' 'src/components/**/*.test.tsx'",
    "privacy:check": "node scripts/check-public-privacy.mjs",
    "privacy:check:history": "node scripts/check-public-privacy.mjs --history",
    "privacy:verify-history-rewrite": "node scripts/verify-public-history-rewrite.mjs",
    "setup:agent": "tsx scripts/setup-agent.ts",
    "seed": "tsx scripts/seed-test-data.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "bullmq": "5.81.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "ws": "8.21.1",
    "zod": "^4.4.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "playwright": "1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "js-yaml": "3.15.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
